{
  "name": "context-mode-doltlite",
  "description": "Context-mode hooks for context window protection",
  "hooks": {
    "preToolUse": [
      {
        "matcher": "execute_bash|fs_read|@context-mode-doltlite/ctx_execute|@context-mode-doltlite/ctx_execute_file|@context-mode-doltlite/ctx_batch_execute",
        "command": "context-mode-doltlite hook kiro pretooluse"
      }
    ],
    "postToolUse": [
      {
        "matcher": "*",
        "command": "context-mode-doltlite hook kiro posttooluse"
      }
    ]
  }
}
