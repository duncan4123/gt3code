#!/usr/bin/env bash
# gc-beads-br — Gas City exec beads provider wrapping beads_rust (br CLI).
#
# Usage:
#   export GC_BEADS=exec:/path/to/contrib/beads-scripts/gc-beads-br
#   gc start my-city
#
# Dependencies: br (beads_rust), jq, bash
#
# Label conventions:
#   parent:<id>  — tracks parent-child relationships
#   needs:<id>   — tracks step dependencies
#
# Metadata is stored in br's metadata KV table under issue:<id>:metadata.
# Older metahex labels are still decoded on read for already-created beads.
#
# Operations that Gas City composes in Go (exit 2):
#   mol-cook  — composed from Create calls by exec.Store
#   init      — not needed (br init is separate)
#   config-set — not applicable
#   purge     — not supported
set -euo pipefail

op="${1:?usage: gc-beads-br <operation> [args...]}"
shift

# If BR_DIR is set, change to that directory so br uses it as the store root.
# Gas City exec providers project GC_STORE_ROOT for city/rig-scoped stores.
if [ -n "${BR_DIR:-}" ]; then
  cd "$BR_DIR"
elif [ -n "${GC_STORE_ROOT:-}" ]; then
  cd "$GC_STORE_ROOT"
fi

if [ -z "${BR_BIN:-}" ]; then
  script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  if [ -x "$script_dir/br" ]; then
    BR_BIN="$script_dir/br"
  else
    BR_BIN="br"
  fi
fi

# join_labels joins an array of labels with commas for br --labels flag.
join_labels() {
  local IFS=","
  echo "$*"
}

# hex_encode returns a lowercase hex encoding of stdin.
hex_encode() {
  od -An -tx1 -v | tr -d ' \n'
}

# hex_decode decodes a lowercase hex string to UTF-8 text.
hex_decode() {
  local hex="${1:-}"
  if [ -z "$hex" ]; then
    return 0
  fi
  printf '%b' "$(printf '%s' "$hex" | sed 's/../\\x&/g')"
}

issue_metadata_json() {
  local id="$1"
  if [ -n "${ISSUE_METADATA_MAP_CACHE:-}" ]; then
    jq -cn --argjson metadata_map "$ISSUE_METADATA_MAP_CACHE" --arg id "$id" '$metadata_map[$id] // {}'
    return 0
  fi
  "$BR_BIN" gc-metadata get "$id" 2>/dev/null || echo '{}'
}

load_issue_metadata_map() {
  "$BR_BIN" gc-metadata list 2>/dev/null || echo '{}'
}

set_issue_metadata_json() {
  local id="$1" metadata="$2"
  if [ -z "$id" ] || [ -z "$metadata" ]; then
    return 0
  fi
  if ! printf '%s' "$metadata" | jq -e 'type == "object"' >/dev/null 2>&1; then
    return 0
  fi
  printf '%s' "$metadata" | "$BR_BIN" gc-metadata set "$id" >/dev/null
}

# safe_label maps Gas City labels into br's stricter label grammar.
safe_label() {
  local label="$1" hex digest
  if [[ "$label" =~ ^[A-Za-z0-9_:-]+$ ]] && [ "${#label}" -le 50 ]; then
    printf '%s\n' "$label"
    return 0
  fi
  hex=$(printf '%s' "$label" | hex_encode)
  if [ $((9 + ${#hex})) -le 50 ]; then
    printf 'labelhex:%s\n' "$hex"
    return 0
  fi
  digest=$(printf '%s' "$label" | sha256sum | awk '{print substr($1,1,32)}')
  printf 'labelhash:%s\n' "$digest"
}

decode_label() {
  local label="$1" hex
  case "$label" in
    labelhex:*)
      hex="${label#labelhex:}"
      hex_decode "$hex"
      ;;
    labelhash:*)
      printf '%s\n' "$label"
      ;;
    *)
      printf '%s\n' "$label"
      ;;
  esac
}

# json_string_array renders argv as a JSON string array.
json_string_array() {
  if [ "$#" -eq 0 ]; then
    echo '[]'
    return 0
  fi
  printf '%s\n' "$@" | jq -R . | jq -s .
}

# br_stream_objects emits one compact br object per line from array/object JSON.
br_stream_objects() {
  jq -c '
    if type == "array" then
      .[]
    elif type == "object" and has("issues") then
      .issues[]
    else
      .
    end
  '
}

# br_object_to_gc converts one compact br JSON object to Gas City wire format.
br_object_to_gc() {
  local obj="$1"
  local parent_id="" key value rest key_hex value_hex decoded_label
  local -a kept_labels=()
  local -a needs=()
  local metadata='{}'
  metadata=$(issue_metadata_json "$(printf '%s' "$obj" | jq -r '.id // ""')")

  while IFS= read -r label; do
    case "$label" in
      parent:*)
        if [ -z "$parent_id" ]; then
          parent_id="${label#parent:}"
        fi
        ;;
      needs:*)
        needs+=("${label#needs:}")
        ;;
      metahex:*)
        rest="${label#metahex:}"
        key_hex="${rest%%:*}"
        value_hex="${rest#*:}"
        if [ "$value_hex" = "$rest" ]; then
          kept_labels+=("$label")
          continue
        fi
        key=$(hex_decode "$key_hex")
        value=$(hex_decode "$value_hex")
        metadata=$(jq -cn --argjson m "$metadata" --arg k "$key" --arg v "$value" '$m + {($k): $v}')
        ;;
      *)
        decoded_label=$(decode_label "$label")
        kept_labels+=("$decoded_label")
        ;;
    esac
  done < <(printf '%s' "$obj" | jq -r '.labels // [] | .[]')

  local labels_json needs_json
  labels_json=$(json_string_array "${kept_labels[@]}")
  needs_json=$(json_string_array "${needs[@]}")

  printf '%s' "$obj" | jq -c \
    --arg parent_id "$parent_id" \
    --argjson labels "$labels_json" \
    --argjson needs "$needs_json" \
    --argjson metadata "$metadata" \
    '{
      id: .id,
      title: .title,
      status: (if .status == "blocked" or .status == "review" or .status == "testing" then "open" else .status end),
      type: (.issue_type // .type // "task"),
      priority: .priority,
      created_at: .created_at,
      assignee: (.assignee // ""),
      from: (.owner // .from // ""),
      parent_id: $parent_id,
      ref: (.external_ref // .ref // ($metadata["gc.ref"] // "")),
      needs: $needs,
      description: (.description // ""),
      labels: $labels,
      metadata: $metadata
    }'
}

# br_to_gc converts a single br JSON object or single-element array to one GC object.
br_to_gc() {
  local payload
  payload=$(cat)
  local first
  first=$(printf '%s' "$payload" | br_stream_objects | head -n 1)
  if [ -z "$first" ]; then
    echo '{}'
    return 0
  fi
  br_object_to_gc "$first"
}

# br_list_to_gc converts br JSON array/object payloads to a GC JSON array.
br_list_to_gc() {
  local payload
  payload=$(cat)
  if [ -z "$payload" ]; then
    echo '[]'
    return 0
  fi
  ISSUE_METADATA_MAP_CACHE=$(load_issue_metadata_map)
  while IFS= read -r obj; do
    br_object_to_gc "$obj"
  done < <(printf '%s' "$payload" | br_stream_objects) | jq -s .
}

collect_br_list_args() {
  br_filter_args=()
  br_list_has_status=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json|--all)
        shift
        ;;
      --metadata-field=*)
        shift
        ;;
      --metadata-field)
        shift
        [ "$#" -gt 0 ] && shift
        ;;
      --status=*)
        br_filter_args+=("$1")
        br_list_has_status=1
        shift
        ;;
      --status)
        flag="$1"
        shift
        if [ "$#" -gt 0 ]; then
          br_filter_args+=("$flag" "$1")
          br_list_has_status=1
          shift
        fi
        ;;
      --assignee=*|--type=*|--label=*|--label-any=*|--priority=*|--priority-min=*|--priority-max=*|--id=*|--limit=*|--offset=*|--sort=*|--title-contains=*|--desc-contains=*|--notes-contains=*)
        br_filter_args+=("$1")
        shift
        ;;
      --assignee|--type|--label|--label-any|--priority|--priority-min|--priority-max|--id|--limit|--offset|--sort|--title-contains|--desc-contains|--notes-contains)
        flag="$1"
        shift
        if [ "$#" -gt 0 ]; then
          br_filter_args+=("$flag" "$1")
          shift
        fi
        ;;
      --unassigned|--deferred|--overdue|--reverse)
        br_filter_args+=("$1")
        shift
        ;;
      *)
        shift
        ;;
    esac
  done
}

collect_br_ready_args() {
  br_filter_args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json|--all)
        shift
        ;;
      --metadata-field=*)
        shift
        ;;
      --metadata-field)
        shift
        [ "$#" -gt 0 ] && shift
        ;;
      --assignee=*|--type=*|--label=*|--label-any=*|--priority=*|--limit=*|--sort=*|--parent=*)
        br_filter_args+=("$1")
        shift
        ;;
      --assignee|--type|--label|--label-any|--priority|--limit|--sort|--parent)
        flag="$1"
        shift
        if [ "$#" -gt 0 ]; then
          br_filter_args+=("$flag" "$1")
          shift
        fi
        ;;
      --unassigned|--include-deferred|--recursive)
        br_filter_args+=("$1")
        shift
        ;;
      *)
        shift
        ;;
    esac
  done
}

case "$op" in
  create)
    input=$(cat)
    title=$(echo "$input" | jq -r '.title')
    bead_type=$(echo "$input" | jq -r '.type // "task"')
    parent_id=$(echo "$input" | jq -r '.parent_id // ""')
    ref=$(echo "$input" | jq -r '.ref // ""')
    description=$(echo "$input" | jq -r '.description // ""')
    assignee=$(echo "$input" | jq -r '.assignee // ""')
    owner=$(echo "$input" | jq -r '.from // ""')

    # Collect all labels into an array.
    all_labels=()
    # User-provided labels.
    while IFS= read -r label; do
      [ -n "$label" ] && all_labels+=("$(safe_label "$label")")
    done < <(echo "$input" | jq -r '.labels // [] | .[]')

    # Parent tracking via label.
    [ -n "$parent_id" ] && all_labels+=("parent:$parent_id")

    # Needs tracking via labels.
    while IFS= read -r need; do
      [ -n "$need" ] && all_labels+=("needs:$need")
    done < <(echo "$input" | jq -r '.needs // [] | .[]')

    metadata_json=$(echo "$input" | jq -c --arg ref "$ref" '
      (.metadata // {}) as $metadata
      | if $ref == "" then $metadata else $metadata + {"gc.ref": $ref} end
    ')

    # Build create command.
    cmd_args=("$BR_BIN" create --json --lock-timeout 10000 --type="$bead_type")
    [ -n "$description" ] && cmd_args+=(--description "$description")
    [ -n "$assignee" ] && cmd_args+=(--assignee "$assignee")
    [ -n "$owner" ] && cmd_args+=(--owner "$owner")
    if [ ${#all_labels[@]} -gt 0 ]; then
      cmd_args+=(--labels "$(join_labels "${all_labels[@]}")")
    fi
    cmd_args+=("$title")

    created=$("${cmd_args[@]}")
    created_id=$(printf '%s' "$created" | br_stream_objects | head -n 1 | jq -r '.id // ""')
    set_issue_metadata_json "$created_id" "$metadata_json"
    printf '%s' "$created" | br_to_gc
    ;;

  get)
    # br show returns an array; extract the first element.
    "$BR_BIN" show --json --lock-timeout 10000 "$1" | jq '.[0]' | br_to_gc
    ;;

  update)
    id="$1"
    input=$(cat)
    cmd_args=("$BR_BIN" update --json --lock-timeout 10000 "$id")

    description=$(echo "$input" | jq -r '.description // empty')
    [ -n "$description" ] && cmd_args+=(--description "$description")

    assignee=$(echo "$input" | jq -r '.assignee // empty')
    [ -n "$assignee" ] && cmd_args+=(--assignee "$assignee")

    # Append labels via --add-label (one per flag).
    while IFS= read -r label; do
      [ -n "$label" ] && cmd_args+=(--add-label "$(safe_label "$label")")
    done < <(echo "$input" | jq -r '.labels // [] | .[]')

    # Handle parent_id change.
    parent_id=$(echo "$input" | jq -r '.parent_id // empty')
    [ -n "$parent_id" ] && cmd_args+=(--add-label "parent:$parent_id")

    "${cmd_args[@]}" > /dev/null
    metadata_json=$(echo "$input" | jq -c '.metadata // empty')
    [ -n "$metadata_json" ] && set_issue_metadata_json "$id" "$metadata_json"
    true
    ;;

  close)
    id="$1"
    current=$("$BR_BIN" show --json --lock-timeout 10000 "$id" 2>/dev/null || true)
    if [ -z "$current" ]; then
      echo "bead $id not found" >&2
      exit 1
    fi
    status=$(printf '%s' "$current" | jq -r '.[0].status // .status // ""')
    if [ "$status" = "closed" ]; then
      exit 0
    fi
    "$BR_BIN" close --json --lock-timeout 10000 "$id" > /dev/null
    ;;

  list)
    collect_br_list_args "$@"
    cmd_args=("$BR_BIN" list --json --lock-timeout 10000)
    [ "$br_list_has_status" -eq 0 ] && cmd_args+=(--all)
    cmd_args+=("${br_filter_args[@]}")
    "${cmd_args[@]}" | br_list_to_gc
    ;;

  ready)
    collect_br_ready_args "$@"
    "$BR_BIN" ready --json --lock-timeout 10000 "${br_filter_args[@]}" | br_list_to_gc
    ;;

  children)
    parent_id="$1"
    # Sort by created_at to match the "in creation order" contract.
    "$BR_BIN" list --json --all --lock-timeout 10000 --label "parent:$parent_id" | br_list_to_gc | jq 'sort_by(.created_at)'
    ;;

  list-by-label)
    label="$1"
    limit="${2:-0}"
    if [ "$limit" -gt 0 ] 2>/dev/null; then
      "$BR_BIN" list --json --all --lock-timeout 10000 --label "$label" --limit "$limit" | br_list_to_gc
    else
      "$BR_BIN" list --json --all --lock-timeout 10000 --label "$label" | br_list_to_gc
    fi
    ;;

  set-metadata)
    id="$1"
    key="$2"
    value=$(cat)
    current_metadata=$(issue_metadata_json "$id")
    metadata_json=$(jq -cn --argjson m "$current_metadata" --arg k "$key" --arg v "$value" '$m + {($k): $v}')
    set_issue_metadata_json "$id" "$metadata_json"
    ;;

  ensure-ready|shutdown)
    exit 2  # br is always ready, no server lifecycle
    ;;

  mol-cook|init|config-set|purge)
    exit 2  # Composed in Go / not applicable
    ;;

  *)
    exit 2  # Unknown operation
    ;;
esac
